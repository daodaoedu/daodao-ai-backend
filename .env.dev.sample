# ================================
# App Config
# ================================
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development
SERVICE_NAME=daodao-ai-backend-api

# ================================
# Redis
# ================================
REDIS_URL=redis://redis-dev:6379
REDIS_TTL_HOUR=3h

# ================================
# Database
# ================================
POSTGRES_DATABASE_URL=postgresql://daodao:daodao@pg-dev:5432/ssssss

# ================================
# JWT
# ================================
JWT_SECURITY=xxxxxxxxxxxxxxxxxxxxx.bbbbbbbbbbbbbb.ddd-cccccccccc-dddddddd
JWT_EXPIRATION=6h
MY_TOKEN_ID=xxxxxxxxxxxxxxxxxxxxx.bbbbbbbbbbbbbb.ddd-cccccccccc-dddddddd

# ================================
# LLM Backends
# ================================
# Ollama

LLM_BACKEND__OLLAMA__URL=http://ollama-dev:11434
LLM_BACKEND__OLLAMA__MODEL=phi3:mini

# OpenAI
LLM_BACKEND__OPENAI__URL=https://api.openai.com/v1/responses
LLM_BACKEND__OPENAI__MODEL=gpt-4
LLM_BACKEND__OPENAI__API_KEY=sk-proj-ccccccccccccccccccccc-cccccccc-0A

# Gemini
LLM_BACKEND__GEMINI__URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
LLM_BACKEND__GEMINI__MODEL=gemini
LLM_BACKEND__GEMINI__API_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAA



# Grok
LLM_BACKEND__GROK__URL=https://api.x.ai/v1/chat/completions
LLM_BACKEND__GROK__MODEL=grok-2-latest
LLM_BACKEND__GROK__API_KEY=xai-ccccccccccccccccccccc



# other db
QDRANT_URL=http://qdrant-dev:6333
COLLECTION_NAME = "daodao_collection"
CLICKHOUSE_URL=http://default:@clickhouse-dev:8123/default

CLICKHOUSE_HOST=http://clickhouse-dev
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
# ================================
# App Config
# ================================
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development
SERVICE_NAME=daodao-ai-backend-api

# ================================
# Redis
# ================================
REDIS_URL=redis://redis-dev:6379
REDIS_PASSWORD=
REDIS_TTL_HOURS=3

# ================================
# Database
# ================================

POSTGRES_DB_USER=user
POSTGRES_DB_PASSWORD=password
POSTGRES_DB_HOST=pg-dev
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=db

# ================================
# JWT
# ================================
# Required in every environment; use the issuer's signing secret, not a JWT token.
JWT_SECURITY=
JWT_EXPIRATION=6h

# ================================
# LLM Backends
# ================================
# Ollama

LLM_BACKEND__OLLAMA__URL=http://ollama-dev:11434
LLM_BACKEND__OLLAMA__MODEL=qwen2.5:7b
# 輕量替代（RAM < 8GB）：qwen2.5:3b

# OpenAI
LLM_BACKEND__OPENAI__URL=https://api.openai.com/v1/responses
LLM_BACKEND__OPENAI__MODEL=gpt-4o
LLM_BACKEND__OPENAI__API_KEY=sk-proj-ccccccccccccccccccccc-cccccccc-0A

# Gemini（預設 LLM）
LLM_BACKEND__GEMINI__URL=https://generativelanguage.googleapis.com
LLM_BACKEND__GEMINI__MODEL=gemini-2.5-flash
LLM_BACKEND__GEMINI__API_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Anthropic Claude
LLM_BACKEND__ANTHROPIC__URL=https://api.anthropic.com/v1/messages
LLM_BACKEND__ANTHROPIC__MODEL=claude-3-5-sonnet-20241022
LLM_BACKEND__ANTHROPIC__API_KEY=sk-ant-ccccccccccccccccccccc

# Groq（免費，推薦）申請：https://console.groq.com
LLM_BACKEND__GROQ__URL=https://api.groq.com/openai/v1
LLM_BACKEND__GROQ__MODEL=openai/gpt-oss-20b
LLM_BACKEND__GROQ__API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Workers AI 申請：https://developers.cloudflare.com/workers-ai/
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BACKEND__CLOUDFLARE__API_KEY=            # Cloudflare API Token（Workers AI Read + Write 權限）

# NVIDIA NIM 申請：https://build.nvidia.com
LLM_BACKEND__NVIDIA__API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cerebras 申請：https://cloud.cerebras.ai
LLM_BACKEND__CEREBRAS__API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter（免費方案 50 req/day）申請：https://openrouter.ai
LLM_BACKEND__OPENROUTER__API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Cloud 申請：https://ollama.com（建立 API key 後設定）
LLM_BACKEND__OLLAMA_CLOUD__API_KEY=

# ================================
# 精選洞察排程
# ================================
INSIGHT__SCHEDULE_CRON=0 1 * * *
INSIGHT__LLM_BACKEND=cloudflare



# other db
QDRANT_URL=http://qdrant-dev:6333
COLLECTION_NAME=my_collection


CLICKHOUSE_HOST=clickhouse-dev
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Required in every environment; separate from JWT, Redis and metrics credentials.
API_SECRET_KEY=
# Empty disables metrics access. Use a separate random hex credential.
METRICS_SECRET=

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0903,  # too-few-public-methods
    import-error,
    no-name-in-module,
    unused-argument,
    not-callable,  # SQLAlchemy func.now()/func.count() 等為已知誤判
    C0302  # too-many-lines: service 模組行數限制放寬

[TYPECHECK]
# SQLAlchemy func proxy (func.now, func.count, ...) 是動態屬性，pylint 無法靜態分析
ignored-classes=func,scoped_session
